{
  "_comment": "Template. deploy.sh renders the ${...} placeholders and drops job_clusters entirely when deploying to serverless compute. Do not run this file through `databricks jobs create` directly — the placeholders are not valid Databricks values.",
  "name": "${JOB_NAME}",
  "description": "Project Sentinel — UPI telemetry generation and the Landing/Bronze/Silver/Gold medallion pipeline.",
  "max_concurrent_runs": 1,
  "tags": {
    "project": "sentinel",
    "managed_by": "deploy.sh"
  },
  "job_clusters": [
    {
      "job_cluster_key": "sentinel_cluster",
      "new_cluster": {
        "spark_version": "${SPARK_VERSION}",
        "node_type_id": "${NODE_TYPE}",
        "num_workers": ${NUM_WORKERS},
        "data_security_mode": "SINGLE_USER",
        "spark_conf": {
          "spark.sql.session.timeZone": "Asia/Kolkata"
        }
      }
    }
  ],
  "parameters": [
    { "name": "env", "default": "databricks" },
    { "name": "scale", "default": "${SCALE}" }
  ],
  "tasks": [
    {
      "task_key": "generate",
      "description": "Step 0 — drop simulated UPI JSON into the Unity Catalog Volume.",
      "job_cluster_key": "sentinel_cluster",
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/00_generate",
        "base_parameters": {
          "env": "{{job.parameters.env}}",
          "scale": "{{job.parameters.scale}}"
        }
      },
      "libraries": [{ "whl": "${WHEEL_PATH}" }]
    },
    {
      "task_key": "landing",
      "description": "Step 1 — land the raw files untransformed.",
      "depends_on": [{ "task_key": "generate" }],
      "job_cluster_key": "sentinel_cluster",
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/01_landing",
        "base_parameters": {
          "env": "{{job.parameters.env}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "libraries": [{ "whl": "${WHEEL_PATH}" }]
    },
    {
      "task_key": "bronze",
      "description": "Step 2 — structure the landed data as Delta, preserving the mess.",
      "depends_on": [{ "task_key": "landing" }],
      "job_cluster_key": "sentinel_cluster",
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/02_bronze",
        "base_parameters": {
          "env": "{{job.parameters.env}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "libraries": [{ "whl": "${WHEEL_PATH}" }]
    },
    {
      "task_key": "silver",
      "description": "Step 3 — cleanse, mask PII, quarantine invalid records.",
      "depends_on": [{ "task_key": "bronze" }],
      "job_cluster_key": "sentinel_cluster",
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/03_silver",
        "base_parameters": {
          "env": "{{job.parameters.env}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "libraries": [{ "whl": "${WHEEL_PATH}" }]
    },
    {
      "task_key": "gold",
      "description": "Step 4 — KPIs and fraud scoring.",
      "depends_on": [{ "task_key": "silver" }],
      "job_cluster_key": "sentinel_cluster",
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/04_gold",
        "base_parameters": {
          "env": "{{job.parameters.env}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "libraries": [{ "whl": "${WHEEL_PATH}" }]
    }
  ]
}
